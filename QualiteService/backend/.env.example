# Qualité KCQ (module MyKyntus)
PORT=5000
MONGO_URI=mongodb://kcq-mongo:27017/kcq
JWT_SECRET=
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthServiceClient
DIRECTORY_BASE_URL=http://employee-directory-backend:8080
# Synchro annuaire au démarrage, puis toutes les 10 min (0 = désactiver l'intervalle)
DIRECTORY_SYNC_INTERVAL_MS=600000

