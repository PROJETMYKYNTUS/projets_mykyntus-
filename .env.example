# Copier ce fichier vers .env à la racine du dépôt (jamais committer .env).
# Docker Compose charge automatiquement .env depuis ce répertoire.
#
# Développement local .NET (sans Docker) — variables d'environnement équivalentes :
#   set ConnectionStrings__DefaultConnection=...
#   set JwtSettings__Secret=...
# (PowerShell : $env:ConnectionStrings__DefaultConnection="...")

# ─── JWT (tous les backends Kyntus) ───────────────────────────────────────────
KYNTUS_JWT_SECRET=change-me-minimum-32-caracteres-secrets-jwt
KYNTUS_JWT_ISSUER=AuthService
KYNTUS_JWT_AUDIENCE=AuthServiceClient

# ─── Postgres (stack docker-compose racine) ───────────────────────────────────
KYNTUS_POSTGRES_USER=postgres
KYNTUS_POSTGRES_PASSWORD=change-me-postgres-root

# ─── pgAdmin ───────────────────────────────────────────────────────────────────
KYNTUS_PGADMIN_EMAIL=admin@kyntus.ma
KYNTUS_PGADMIN_PASSWORD=change-me-pgadmin

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
KYNTUS_RABBITMQ_USER=guest
KYNTUS_RABBITMQ_PASSWORD=change-me-rabbitmq
KYNTUS_RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# ─── Mots de passe utilisateurs PostgreSQL (init DB) ─────────────────────────
# Doivent correspondre aux mots de passe dans les KYNTUS_CONN_* ci-dessous.
KYNTUS_DB_PASSWORD_KYNTUS=change-me-planning-db
KYNTUS_DB_PASSWORD_AUTH=change-me-auth-db
KYNTUS_DB_PASSWORD_FORMATION=change-me-formation-db
KYNTUS_DB_PASSWORD_DOCUMENTATION=change-me-documentation-db
KYNTUS_DB_PASSWORD_CONGE=change-me-conge-db
KYNTUS_DB_PASSWORD_PRIME=change-me-prime-db
KYNTUS_DB_PASSWORD_PARRAINAGE=change-me-parrainage-db
KYNTUS_DB_PASSWORD_DIRECTORY=change-me-directory-db

# ─── Chaînes de connexion (services Docker) ───────────────────────────────────
KYNTUS_CONN_AUTH=Host=postgres;Port=5432;Database=auth_db;Username=auth_user;Password=change-me-auth-db
KYNTUS_CONN_PLANNING=Host=postgres;Port=5432;Database=kyntus_db;Username=kyntus_user;Password=change-me-planning-db
KYNTUS_CONN_FORMATION=Host=postgres;Port=5432;Database=formation_db;Username=formation_user;Password=change-me-formation-db
KYNTUS_CONN_DOCUMENTATION=Host=postgres;Port=5432;Database=documentation_db;Username=documentation_user;Password=change-me-documentation-db
KYNTUS_DOCUMENTATION_DB_PASSWORD=change-me-documentation-db
KYNTUS_CONN_CONGE=Host=postgres;Port=5432;Database=conge_db;Username=postgres;Password=change-me-conge-db
KYNTUS_CONN_PRIME=Host=postgres;Port=5432;Database=prime_db;Username=prime_user;Password=change-me-prime-db
KYNTUS_CONN_PARRAINAGE=Host=postgres;Port=5432;Database=parrainage_db;Username=parrainage_user;Password=change-me-parrainage-db
KYNTUS_CONN_DIRECTORY=Host=postgres;Port=5432;Database=employee_directory_db;Username=directory_user;Password=change-me-directory-db

# ─── AuthService seul (AuthService/AuthService/docker-compose.yml) ───────────
KYNTUS_AUTH_STANDALONE_POSTGRES_PASSWORD=change-me-auth-standalone
KYNTUS_AUTH_STANDALONE_DB_CONNECTION=Host=postgres;Port=5432;Database=AuthServiceDb;Username=postgres;Password=change-me-auth-standalone

# Les mots de passe des utilisateurs dans init/docker-entrypoint-initdb.d/
# doivent correspondre aux KYNTUS_DB_PASSWORD_* et aux KYNTUS_CONN_* ci-dessus.

# ─── Auth login seed (rôles + comptes de connexion) ───────────────────────────
KYNTUS_DEMO_SEED_ENABLED=true
KYNTUS_DEMO_SEED_PASSWORD_EMPLOYEE=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_RH=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_MANAGER=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_COACH=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_RP=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_ADMIN=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_AUDIT=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_FORMATION=Azerty@123
KYNTUS_DEMO_SEED_PASSWORD_SUPERVISEUR=Azerty@123

# ─── Développement local hors Docker (exemples — adapter à votre machine) ─────
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AuthServiceDb;Username=postgres;Password=
# JwtSettings__Secret=
